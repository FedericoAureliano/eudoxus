module TrafficLights {
  type Bit = boolean;

  var b0: boolean;
  var b1: boolean;
  var state: boolean;

  output mG: Bit;
  output mY: Bit;
  output mR: Bit;
  output sG: Bit;
  output sY: Bit;
  output sR: Bit;

  init {
    state = b0; //57

  }
  procedure step()
    modifies mG;
    modifies state;
    modifies sY;
    modifies mY;
    modifies mR;
    modifies sG;
    modifies sR;
  {
    if (state == b0) {
      mG = b1; //71
      mY = b0; //76
      mR = b0; //81
      sG = b0; //86
      sY = b0; //91
      sR = b1; //96
      if (sY == b1) {
        state = b1; //108
      }
    }
    if (state == b1) {
      mG = b0; //124
      mY = b1; //129
      mR = b0; //134
      sG = b0; //139
      sY = b0; //144
      sR = b1; //149
      if (sY == b1) {
        state = b0; //161
      }
    }
  }

  next {
    call step();
  }
  invariant spec: (mG ==> (!sG && !sY));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
