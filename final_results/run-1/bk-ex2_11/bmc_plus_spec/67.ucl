module Circuit {
  var y: boolean;
  var x: boolean;
  var r: boolean;

  init {
    r = false; //26
    if (x == false) {
      y = !x; //38
    } else {
      y = !r; //45
    }
    if (r == false) {
      r = (r || x); //60
    }

  }
  invariant spec: (y_inv && r_inv);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
