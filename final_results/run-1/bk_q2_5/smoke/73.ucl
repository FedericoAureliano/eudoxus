module MutualExclusionProtocol {
  var s: bv1;
  var y0: boolean;
  var y1: boolean;

  next {
    if (s == 1bv1) {
      y0' = true; //37
    }
    if (y1 == false) {
      y1' = true; //49
    }

  }
  invariant spec: ((s == 1bv1) && ((y0 == y1) && (y1 == false)));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
