module Module {
  var r: boolean;
  var x: boolean;
  var y: boolean;
  var next_r: boolean;

  init {
    r = false; //30

  }
  next {
    next_r' = (x || r); //40
    r' = (if (r) then r else next_r); //50
    y' = !(x ^ r); //60

  }
  invariant r_inv : (r ^ !next_r);
  invariant y_inv : !(x ^ r);
  invariant next_r_inv : (x || r);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
