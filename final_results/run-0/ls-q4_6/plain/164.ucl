module Module {
  var door_open: integer;
  var time: real;
  var door_open_count: integer;
  var light_on: boolean;
  var start_time: real;

  init {
    light_on = false; //34
    start_time = 0.0; //38

  }
  next {
    door_open_count' = door_open; //45
    if (door_open_count > 0) {
      light_on' = true; //55
      start_time' = time; //60
    } else {
      if ((time - start_time) >= 30.0) {
        light_on' = false; //74
      }
    }

  }
}
