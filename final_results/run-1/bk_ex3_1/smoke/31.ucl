module TrafficLight {
  var green1: integer;
  var green2: real;
  var red1: integer;
  var red2: real;
  var traffic_light1: integer;
  var traffic_light2: real;
  var a: boolean;
  var b: bv1;

  init {
    traffic_light1 = red1; //48
    traffic_light2 = green2; //53

  }
  next {
    if (a) {
      if (traffic_light1 == red1) {
        traffic_light1' = green1; //70
        traffic_light2' = red2; //75
      } else {
        traffic_light1' = red1; //81
        traffic_light2' = green2; //86
      }
    }

  }
}
