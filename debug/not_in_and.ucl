HEREAHADGJSD: (3, 25)
HEREAHADGJSD: (4, 23)
HEREAHADGJSD: (5, 26)
HEREAHADGJSD: (16, 32)
HEREAHADGJSD: (19, 18)
HEREAHADGJSD: (19, 22)
HEREAHADGJSD: (19, 38)
module TrafficLight {
  var previous_state: enum { yellow };
  var green: boolean;
  var red: boolean;
  var yellow: boolean;

  init {
    green = false;
    red = false;
    yellow = false;

  }
  next {
    yellow' = green;
    red' = yellow;
    green' = !red;
    previous_state' = (if (red) then ?? else previous_state);

  }
  invariant spec: (yellow && (!red && !green));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
