module BeverageVendingMachine {
  type Variable = boolean;

  var coin_inserted: Variable;
  var drinks_dispensed: Variable;
  var coin: bv32;
  var dispensed_drinks: bv32;

  init {
    coin = 0bv32; //40
    dispensed_drinks = 0bv32; //47

  }
  next {
    coin_inserted' = (coin >= 0bv32); //60
    drinks_dispensed' = (dispensed_drinks >= 0bv32); //71

  }
  invariant coin_dispensed_drinks_relation_inv : (coin >= dispensed_drinks);
  invariant coin_inv : (coin >= 0bv32);
  invariant dispensed_drinks_inv : (dispensed_drinks >= 0bv32);
  invariant coin_inserted_aux : (coin >= 0bv32);
  invariant drinks_dispensed_aux : (dispensed_drinks >= 0bv32);
  invariant coin_dispensed_drinks_aux : (coin >= dispensed_drinks);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
