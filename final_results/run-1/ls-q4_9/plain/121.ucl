module TrafficLight {
  var mG: boolean;
  var mY: boolean;
  var mR: boolean;
  var sG: boolean;
  var sY: boolean;
  var sR: boolean;
  var vehicle: boolean;

  init {
    mG = false; //42
    mY = false; //46
    mR = true; //50
    sG = false; //54
    sY = false; //58
    sR = true; //62
    vehicle = false; //66

  }
  procedure step()
    modifies mG;
    modifies sR;
    modifies sG;
    modifies mR;
    modifies mY;
    modifies sY;
  {
    if (!vehicle) {
      if (!sG && !sY) {
        mG = true; //84
        mR = false; //88
        mY = (if (mG) then false else true); //96
        sG = (if (mG) then false else true); //104
        mG = false; //108
        mY = true; //112
        sG = false; //116
        sY = true; //120
        mY = false; //124
        mR = true; //128
      } else {
        mG = false; //133
        mY = true; //137
        mR = false; //141
        mY = false; //145
        mR = true; //149
        sG = false; //153
        sY = false; //157
        sR = true; //161
      }
    } else {
      mG = false; //167
      mY = true; //171
      sG = false; //175
      sY = true; //179
      mR = (if (sG || sY) then false else true); //190
      mY = false; //194
      mR = true; //198
      sY = false; //202
      sR = true; //206
    }
  }

  next {
    call step();
  }
}
