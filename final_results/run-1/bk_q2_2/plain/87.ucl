module Process {
  var x: integer;

  init {
    x = 0; //18

  }
  next {
    x' = (x + 1); //27

  }
}
module ParallelProcess {
  var x: integer;

  instance p1: Process();
  instance p2: Process();
  instance p3: Process();

  next {
    next(p1); //58
    next(p2); //61
    next(p3); //64

  }
  invariant spec: (x == 2);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
