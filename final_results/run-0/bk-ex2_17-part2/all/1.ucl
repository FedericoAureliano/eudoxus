module TrafficLight {
  var state1: boolean;
  var state2: boolean;

  init {
    state1 = false; //22
    state2 = false; //26

  }
  next {
    if (state1) {
      state1' = false; //35
      state2' = true; //39
    } else {
      state1' = true; //44
      state2' = false; //48
    }

  }
  invariant state1_inv : !state1;
  invariant state2_inv : !state2;
  invariant red1_and_green1_inv : (!red1 && !green1);
  invariant red2_and_green2_inv : (!red2 && !green2);
  invariant red1 : !state1;
  invariant green1 : state1;
  invariant red2 : !state2;
  invariant green2 : state2;

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
