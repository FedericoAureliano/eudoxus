module Module {
  var carry_anything: bv4;
  var ferryman: bv2;
  var goat: bv4;
  var cabbage: bv4;
  var wolf: bv4;
  var carry: bv4;

  init {
    ferryman = 0bv2; //47
    goat = 2bv4; //54
    cabbage = 4bv4; //61
    wolf = 8bv4; //68
    carry = 0bv4; //75

  }
  next {
    carry_anything' = (if (ferryman == 0bv2) then wolf else (if (ferryman == 2bv2) then cabbage else goat)); //104

  }
  invariant spec: ((((goat == 0bv4) && (cabbage == 0bv4)) && (wolf == 0bv4)) && (ferryman == 0bv2));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
