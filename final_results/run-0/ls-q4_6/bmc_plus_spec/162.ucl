module Module {
  var light_on: boolean;
  var door_open: boolean;
  var time: integer;

  init {
    light_on = false; //26
    door_open = false; //30
    time = 30; //34

  }
  next {
    if (door_open) {
      light_on' = true; //43
      time' = 30; //47
    } else {
      if (time > 0) {
        time' = (time - 1); //61
      } else {
        light_on' = false; //66
      }
    }

  }
  invariant door_open_inv : (light_on || (time <= 30));
  invariant light_on_inv : door_open;
  invariant time_inv : ((0 <= time) && (time <= 30));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
