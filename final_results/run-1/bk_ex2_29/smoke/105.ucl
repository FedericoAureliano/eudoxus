module BookingSystem {
  var BCR_scan: boolean;
  var BP_receive: boolean;
  var Printer_print: boolean;
  var Printer_printed: boolean;
  var BCR_state: bv1;
  var BP_state: bv1;
  var Printer_state: bv1;

  next {
    if (BCR_state == 0bv1) {
      if (BCR_scan) {
        BCR_state' = 1bv1; //61
      }
    } else {
      if (BCR_state == 1bv1) {
        if (BP_receive) {
          BCR_state' = 0bv1; //83
        }
      }
    }
    if (BP_state == 0bv1) {
      if (BP_receive) {
        BP_state' = 1bv1; //107
      }
    } else {
      if (BP_state == 1bv1) {
        if (Printer_printed) {
          BP_state' = 0bv1; //129
        }
      }
    }
    if (Printer_state == 0bv1) {
      if (Printer_print) {
        Printer_state' = 1bv1; //153
      }
    } else {
      if (Printer_state == 1bv1) {
        if (Printer_printed) {
          Printer_state' = 0bv1; //175
        }
      }
    }

  }
}
