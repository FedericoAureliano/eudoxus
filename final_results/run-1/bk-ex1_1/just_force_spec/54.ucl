module Module {
  var Dec: boolean;
  var Inc: boolean;
  var Reset: boolean;
  var x: integer;

  init {
    x = 100; //30

  }
  next {
    Inc' = (x < 200); //40
    Dec' = (x > 0); //48
    Reset' = (x == 200); //56

  }
  invariant x_inv : ((x >= 0) && (x <= 200));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
