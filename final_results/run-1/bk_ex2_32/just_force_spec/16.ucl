module Module {
  var c: boolean;

  output m: boolean;
  output b: boolean;

  next {
    if (b == false) {
      c' = m; //35
    } else {
      if (c) {
        c' = m; //44
      }
      b' = !b; //52
    }

  }
}
module Sender {
  var c: boolean;

  output m: boolean;
  output b: boolean;

  next {
    if (b == false) {
      c' = m; //91
    } else {
      if (c) {
        c' = m; //100
      }
      b' = !b; //108
    }

  }
}
module Receiver {
  var d: [bv8]boolean;

  input c: boolean;

  output m: boolean;
  output b: boolean;

  next {
    d' = d; //151
    b' = b; //156

  }
  invariant c_inv : c;
  invariant s_inv : b;
  invariant r_inv : b;
  invariant m_inv : m;
  invariant b_inv : b;
  invariant c : c;
  invariant d_inv : true;
  invariant s_inv : true;
  invariant r_inv : true;
  invariant m_inv : true;
  invariant b_inv : true;

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
