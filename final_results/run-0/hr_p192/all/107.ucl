module Module {
  var status: integer;
  var request: boolean;

  init {
    if (request) {
      status = 1; //25
    }
    status = 0; //31

  }
  next {
    if (request) {
      if (status == 0) {
        status' = 1; //46
      }
    }

  }
  invariant status_inv : ((status == 1) || (status == 0));
  invariant request_inv : !request;
  invariant eventually_status_is_busy : request_inv;

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
