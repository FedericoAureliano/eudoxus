module BeverageVendingMachine {
  var coin_input: integer;
  var drinks_input: integer;
  var input_coin: integer;
  var input_dispensed_drinks: integer;
  var coin: integer;
  var dispensed_drinks: integer;

  init {
    coin = 0; //38
    dispensed_drinks = 0; //42

  }
  next {
    coin_input' = input_coin; //49
    drinks_input' = input_dispensed_drinks; //54
    coin' = coin_input; //59
    dispensed_drinks' = drinks_input; //64
    assert (coin >= dispensed_drinks); //71

  }
  invariant coin_inv : (coin >= dispensed_drinks);
  invariant dispensed_drinks_inv : (dispensed_drinks >= 0);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
