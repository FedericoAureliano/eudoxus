module Module {
  var request: boolean;
  var status: integer;

  invariant status_taken_inv : (request && (status == 1));
  invariant request_inv : ((request == false) || (request == true));
  invariant status_inv : ((status == 0) || (status == 1));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
