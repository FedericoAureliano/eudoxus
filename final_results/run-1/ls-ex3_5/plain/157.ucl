module Module {
  var setpoint: real;

  input temp: real;

  output heatOn: boolean;
  output heatOff: boolean;

  next {
    if (heatOn && (temp >= (setpoint + 2.0))) {
      heatOn' = false; //45
      heatOff' = true; //49
    } else {
      if (heatOff && (temp <= (setpoint - 2.0))) {
        heatOn' = true; //66
        heatOff' = false; //70
      } else {
        heatOn' = false; //75
        heatOff' = false; //79
      }
    }

  }
}
