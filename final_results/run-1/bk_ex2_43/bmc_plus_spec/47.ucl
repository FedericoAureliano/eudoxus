module SynchronousComposition {
  var x2: boolean;
  var y1: boolean;
  var r1: boolean;
  var y2: boolean;
  var r2: boolean;

  init {
    y1 = false; //34
    y2 = false; //38
    r1 = false; //42
    r2 = false; //46

  }
  next {
    y1' = r1; //53
    r1' = !r1; //59
    y2' = (x2 || r2); //67
    r2' = (x2 || r2); //75

  }
  invariant y1_inv : r1;
  invariant r1_inv : !r1;
  invariant y2_inv : (x2 || r2);
  invariant r2_inv : !(x2 || r2);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
