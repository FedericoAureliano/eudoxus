module TrafficLights {
  type state = boolean;

  var nondet_1: boolean;
  var red1: state;
  var green1: state;
  var red2: state;
  var green2: state;

  init {
    red1 = true; //39
    green1 = false; //43
    red2 = true; //47
    green2 = false; //51

  }
  next {
    havoc nondet_1; //56
    if (red1 && red2) {
      if (nondet_1) {
        green1' = true; //69
      } else {
        green2' = true; //74
      }
    } else {
      if (green1 && red2) {
        green1' = false; //86
        red1' = true; //90
        red2' = false; //94
        green2' = true; //98
      } else {
        if (red1 && green2) {
          red1' = false; //109
          green1' = true; //113
          green2' = false; //117
          red2' = true; //121
        } else {
          red1' = true; //126
          green2' = true; //130
        }
      }
    }

  }
}
