module Module {
  var count: integer;
  var temp: integer;
  var threshold: integer;

  next {
    temp_inv' = ((temp >=  -273) && (count >= 0)); //38
    count_inv' = ((temp > threshold) ==> (count == (count + 1))); //57

  }
  invariant temp_inv : (temp >=  -273);
  invariant count_inv : (count >= 0);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
