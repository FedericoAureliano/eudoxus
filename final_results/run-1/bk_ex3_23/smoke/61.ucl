module TrafficLight {
  var red: boolean;
  var green: boolean;
  var yellow: boolean;

  init {
    red = false; //26
    green = false; //30
    yellow = false; //34

  }
  next {
    red' = (if (yellow) then false else true); //44
    green' = (if (red) then true else green); //53
    yellow' = (if (green) then true else (if (red) then false else yellow)); //66

  }
  invariant spec: !(red && yellow);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
