module TrafficLightSystem {
  type Bit = boolean;

  var senses: record { sec_vehicle_detected: Bit };
  var vehicle_detected: boolean;

  output mG: boolean;
  output mY: boolean;
  output mR: boolean;
  output sG: boolean;
  output sY: integer;
  output sR: boolean;

  init {
    mG = false; //55
    mY = false; //59
    mR = true; //63
    sG = false; //67
    sY = 0; //71
    sR = true; //75

  }
  next {
    vehicle_detected' = senses.sec_vehicle_detected; //84
    if (vehicle_detected) {
      mG' = false; //91
      mY' = true; //95
      mR' = false; //99
      sG' = true; //103
      sY' = 0; //107
      sR' = false; //111
    } else {
      if (mG) {
        mG' = false; //119
        mY' = true; //123
        mR' = false; //127
        sG' = false; //131
        sY' = 0; //135
        sR' = true; //139
      } else {
        if (mY) {
          mG' = false; //147
          mY' = false; //151
          mR' = true; //155
          sG' = true; //159
          sY' = 0; //163
          sR' = false; //167
        } else {
          mG' = true; //172
          mY' = false; //176
          mR' = false; //180
          sG' = false; //184
          sY' = 0; //188
          sR' = true; //192
        }
      }
    }

  }
}
