module BookingSystem {
  var print: bv32;
  var BCR_state: bv1;
  var BP_state: bv1;
  var Printer_state: bv1;

  init {
    BCR_state = 0bv1; //37
    BP_state = 0bv1; //44
    Printer_state = 0bv1; //51

  }
  procedure step()
    modifies print;
    modifies BCR_state;
    modifies Printer_state;
    modifies BP_state;
  {
    if (BCR_state == 0bv1) {
      BCR_state = 1bv1; //69
    }
    if (Printer_state == 1bv1) {
      BCR_state = 0bv1; //87
      BP_state = 1bv1; //94
    }
    if (BP_state == 1bv1) {
      print = 0bv32; //112
      Printer_state = 1bv1; //119
    }
  }

  next {
    call step();
  }
  invariant bcr_state_inv : ((BCR_state == 1bv1) == (BP_state == 0bv1));
  invariant bp_state_inv : ((BP_state == 1bv1) == (Printer_state == 0bv1));
  invariant printer_state_inv : ((Printer_state == 1bv1) == (print == 0bv32));
  invariant BCR_state_inv : (BCR_state == 1bv1);
  invariant BP_state_inv : (BP_state == 1bv1);
  invariant Printer_state_inv : (Printer_state == 1bv1);
  invariant BP_state_inv : ((BCR_state == 1bv1) == (BP_state == 0bv1));
  invariant BP_state_inv : ((BP_state == 1bv1) == (Printer_state == 0bv1));
  invariant Printer_state_inv : ((Printer_state == 1bv1) == (print == 0bv32));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
