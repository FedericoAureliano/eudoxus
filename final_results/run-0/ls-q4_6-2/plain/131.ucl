module Module {
  var warn: boolean;
  var nowarn: boolean;
  var time: integer;

  instance sensor: Sensor(warn:(warn), nowarn:(nowarn));
  instance timer: Timer(time:(time));

  procedure step()
    modifies warn;
    modifies time;
  {
    if sensor.warn {
      time = 0; //72
      sensor.warn = false; //78
      warn = true; //82
    }
    if sensor.nowarn {
      time = 0; //93
      sensor.nowarn = false; //99
      warn = false; //103
    }
    if (warn) {
      time = (time + 1); //115
    }
    if (time == 30) {
      warn = false; //127
    }
  }

  next {
    call step();
  }
}
