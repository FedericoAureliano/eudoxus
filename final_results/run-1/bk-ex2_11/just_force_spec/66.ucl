module Module {
  var always_set_y: boolean;
  var next_r: boolean;
  var r: boolean;
  var x: boolean;
  var y: boolean;

  init {
    r = false; //34

  }
  next {
    next_r' = (x || r); //44
    y' = !(x ^ r); //54
    r' = (if (r == true) then r else next_r); //67
    always_set_y' = y; //72

  }
  invariant always_set_y_inv : always_set_y;
  invariant x_inv : !x;
  invariant y_inv : !(x ^ r);
  invariant r_inv : (x || r);
  invariant next_r_inv : (x || r);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
