module Module {
  var busy: boolean;
  var status: boolean;
  var aux: boolean;
  var request: boolean;

  next {
    aux' = (request ==> (status == busy)); //40

  }
  invariant request_inv : request;
  invariant status_inv : ((status == false) || (status == true));
  invariant aux_inv : (request ==> (status == true));
  invariant busy_inv : busy;

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
