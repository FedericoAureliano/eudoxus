module TrafficLight {
  var count: integer;

  output sigR: boolean;
  output sigY: boolean;
  output sigG: boolean;
  output pedestrian: boolean;

  init {
    count = 0; //35
    pedestrian = false; //39
    sigG = false; //43
    sigY = false; //47
    sigR = true; //51

  }
  next {
    if (sigR) {
      if (count < 60) {
        count' = (count + 1); //69
      } else {
        sigR' = false; //74
        sigG' = true; //78
      }
    }
    if (sigG) {
      if (!pedestrian) {
        if (count >= 60) {
          sigG' = false; //98
          sigY' = false; //102
          sigR' = false; //106
        } else {
          count' = (count + 1); //114
        }
      } else {
        sigG' = false; //120
        sigY' = false; //124
        sigR' = false; //128
      }
    }
    if (sigY) {
      if (count < 5) {
        count' = (count + 1); //147
      } else {
        sigY' = false; //152
        sigR' = true; //156
      }
    }

  }
}
