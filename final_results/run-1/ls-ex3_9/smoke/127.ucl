module LightController {
  instance sigG: BitVector();
  instance sigR: BitVector();
  instance sigY: BitVector();

}
module TrafficLightStateMachine {
  type Range = integer;

  var count: integer;
  var pedestrian: boolean;
  var sigG: bv4;
  var sigR: bv7;
  var sigY: bv6;
  var state: Range;

  instance light: LightController();

  init {
    state = 0; //72
    count = 0; //76

  }
  procedure step()
    modifies state;
    modifies count;
    modifies sigG;
    modifies sigY;
    modifies sigR;
  {
    if (state == 0) {
      sigG = 0bv4; //91
      sigY = 0bv6; //98
      sigR = 1bv7; //105
      count = (count + 1); //112
      if (count == 60) {
        state = 1; //122
        count = 0; //126
      }
    } else {
      if (state == 1) {
        sigG = 1bv4; //142
        sigY = 0bv6; //149
        sigR = 0bv7; //156
        if (pedestrian) {
          if (count >= 60) {
            state = 2; //169
            count = 0; //173
          } else {
            state = 3; //178
          }
        }
      } else {
        if (state == 2) {
          sigG = 0bv4; //195
          sigY = 1bv6; //202
          sigR = 0bv7; //209
          count = (count + 1); //216
          if (count == 5) {
            state = 0; //226
            count = 0; //230
          }
        } else {
          if (state == 3) {
            sigG = 0bv4; //246
            sigY = 1bv6; //253
            sigR = 0bv7; //260
            count = (count + 1); //267
            if (count == 60) {
              state = 2; //277
              count = 0; //281
            }
          }
        }
      }
    }
  }

  next {
    call step();
  }
}
