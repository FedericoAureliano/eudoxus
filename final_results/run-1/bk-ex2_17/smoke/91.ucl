module TrafficLight {
  var red: bv1;
  var green: bv1;

  init {
    red = 1bv1; //27
    green = 0bv1; //34

  }
  next {
    if (red == 1bv1) {
      red' = 0bv1; //52
      green' = 1bv1; //59
    } else {
      red' = 1bv1; //67
      green' = 0bv1; //74
    }

  }
  invariant spec: (red != green);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
