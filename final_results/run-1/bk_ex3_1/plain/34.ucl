module TrafficLights {
  type traffic_light = boolean;

  var green1: boolean;
  var green2: boolean;
  var red1: boolean;
  var red2: boolean;
  var traffic_light1: traffic_light;
  var traffic_light2: traffic_light;

  input A: boolean;
  input B: boolean;

  init {
    traffic_light1 = green1; //53
    traffic_light2 = red2; //58

  }
  next {
    if (A) {
      green1' = !green1; //69
      red1' = !red1; //75
    }
    if (B) {
      green2' = !green2; //86
      red2' = !red2; //92
    }

  }
  invariant spec: (!(green1 && green2) && !(red1 && red2));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
