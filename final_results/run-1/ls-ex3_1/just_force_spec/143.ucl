module ParkingGarage {
  var arrival: boolean;
  var departure: boolean;
  var counter: integer;

  init {
    counter = 0; //26

  }
  procedure step()
    modifies counter;
  {
    if (arrival) {
      counter = (counter + 1); //38
    }
    if (departure) {
      counter = (counter - 1); //50
    }
  }

  next {
    call step();
  }
  invariant arrival_inv : arrival;
  invariant departure_inv : departure;
  invariant counter_inv : (counter >= 0);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
