module BeverageVendingMachine {
  var coin_inserted: boolean;
  var drink_dispensed: boolean;
  var coin: integer;
  var dispensed_drinks: integer;

  init {
    coin = 0; //30
    dispensed_drinks = 0; //34

  }
  next {
    coin_inserted' = (coin > 0); //44
    drink_dispensed' = (dispensed_drinks > 0); //52
    if (coin_inserted && drink_dispensed) {
      assert (coin >= dispensed_drinks); //65
    }
    if (coin_inserted) {
      coin' = (coin - 1); //77
    }
    if (drink_dispensed) {
      dispensed_drinks' = (dispensed_drinks - 1); //89
    }

  }
}
