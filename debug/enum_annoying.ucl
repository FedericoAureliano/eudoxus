module RailroadCrossing {
  var train_state: enum { far, in_, near };
  var controller_state : integer;
  var gate_state: enum { down, up };

  input train_approach: boolean;
  input train_exit: boolean;

  output gate_raise: boolean;

  procedure step()
    modifies gate_raise;
    modifies controller_state;
  {
    if ((train_state == far) && train_approach) {
      controller_state = 1;
    }
    if ((train_state == near) && (controller_state == 1)) {
      controller_state = 2;
    }
    if ((train_state == in_) && train_exit) {
      controller_state = 3;
    }
    if (controller_state == 2) {
      controller_state = 3;
    }
    if (controller_state == 3) {
      controller_state = 0;
    }
    gate_raise = (gate_state == up);
  }

  next {
    call step();
  }
  define invariant1() : boolean = ((train_state == in_) == (gate_state == down));
  define invariant2() : boolean = ((train_state == far) == (gate_state == up));
  define invariant3() : boolean = ((controller_state == 0) == (train_state == near));
  define invariant4() : boolean = ((controller_state == 2) == (train_state == far));
  define invariant5() : boolean = (((train_state == far) && (gate_state == up)) && (controller_state == 0));
  invariant spec: (invariant1() && invariant2());

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
