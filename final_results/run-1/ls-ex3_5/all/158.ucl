module Thermostat {
  var next_: bv2;

  input temp: real;

  output heatOn: boolean;
  output heatOff: boolean;

  procedure step()
    modifies heatOn;
    modifies heatOff;
    modifies next_;
  {
    if (heatOn) {
      if (temp >= 22.0) {
        heatOn = (temp >= 22.0); //47
        next_ = 1bv2; //54
      }
      if (heatOff) {
        heatOff = (temp <= 18.0); //67
        next_ = 0bv2; //74
      }
    }
  }

  next {
    call step();
  }
  invariant temp_inv : ((temp >= 18.0) && (temp <= 22.0));
  invariant heatOn_inv : (heatOn == (temp >= 22.0));
  invariant heatOff_inv : (heatOff == (temp <= 18.0));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
