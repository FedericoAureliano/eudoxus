module TrafficLightStateMachine {
  var count: integer;
  var sigG: boolean;
  var sigY: boolean;
  var sigR: boolean;

  input pedestrian: boolean;

  init {
    count = 0; //35
    sigG = false; //39
    sigY = false; //43
    sigR = true; //47

  }
  next {
    if (count < 60) {
      count' = (count + 1); //62
      if (count == 60) {
        sigG' = true; //72
      }
    } else {
      if (sigG && !pedestrian) {
        sigY' = (count >= 120); //90
        sigR' = !sigY; //96
      } else {
        if (sigG && pedestrian) {
          sigR' = (count < 180); //111
          sigY' = !sigR; //117
          if (count < 180) {
            count' = (count + 1); //130
          }
        }
      }
    }

  }
}
