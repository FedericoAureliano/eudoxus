module TrafficLight {
  var mG: boolean;
  var mY: boolean;
  var mR: boolean;
  var sG: boolean;
  var sY: boolean;
  var sR: boolean;

  next {
    if ((mG == true) && (sR == true)) {
      mG' = false; //51
      mY' = true; //55
    } else {
      if (mY == true) {
        mY' = false; //66
        mR' = true; //70
      } else {
        if ((mR == true) && (sR == true)) {
          mR' = false; //87
          mG' = true; //91
        }
      }
    }

  }
}
