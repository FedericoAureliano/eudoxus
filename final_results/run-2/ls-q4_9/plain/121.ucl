module TrafficLights {
  var mG: boolean;
  var mY: boolean;
  var mR: boolean;
  var sG: boolean;
  var sY: boolean;
  var sR: boolean;

  init {
    mG = false; //38
    mY = false; //42
    mR = true; //46
    sG = false; //50
    sY = false; //54
    sR = true; //58

  }
  next {
    if (sG && sY) {
      mY' = true; //70
      mG' = false; //74
      mR' = false; //78
      sG' = false; //82
      sY' = true; //86
      sR' = false; //90
    } else {
      if (sR) {
        if (sR) {
          sG' = true; //101
          if (mG) {
            mY' = true; //108
            mG' = false; //112
          }
        }
      }
    }

  }
}
