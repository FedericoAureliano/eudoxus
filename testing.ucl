module Module {
  var light_on: boolean;
  var door_open: [bv2]boolean;
  var time: integer;

  init {
    time = 0; //31

  }
  next {
    if (light_on && (time < 30)) {
      time' = (time + 1); //49
    } else {
      if (time == 30) {
        time' = 0; //60
      }
    }

  }
  invariant spec: (time <= 30);
  control  {
    v = bmc(62);
    check;
    print_results;
    v.print_cex();
  }
}
