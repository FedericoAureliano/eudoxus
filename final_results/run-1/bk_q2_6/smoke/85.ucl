module StackModule {
  type n = integer;

  var index: integer;
  var s: [integer]n;
  var top_val: integer;

  input push_val: integer;

  init {
    s = s[index -> push_val]; //45
    top_val = s[index]; //53

  }
  next {
    index' = (index + 1); //62
    top_val' = s[index]; //70

  }
  invariant spec: (top_val == s[index]);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
