module TrafficLight {
  var prev_red: boolean;
  var red: boolean;
  var green: boolean;
  var yellow: boolean;

  next {
    prev_red' = red; //32
    red' = yellow; //37
    yellow' = green; //42
    green' = prev_red; //47

  }
  invariant spec: (red || (!yellow && !green));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
