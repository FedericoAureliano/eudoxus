module Junction {
  var traffic_lights: record { L1: lights, L2: lights, L3: lights, L4: lights };
  var cond1: boolean;
  var cond2: boolean;
  var cond3: boolean;
  var cond4: boolean;
  var L1: State;
  var L2: State;
  var L3: State;
  var L4: State;

  init {
    L1 = State.green; //65
    L2 = State.green; //72
    L3 = State.red; //79
    L4 = State.red; //86

  }
  next {
    cond1' = ((L1 == State.green) && (L3 == State.green)); //108
    cond2' = ((L2 == State.green) && (L1 == State.yellow)); //128
    cond3' = ((L2 == State.red) && (L3 == State.yellow)); //148
    cond4' = ((L2 == State.red) && (L4 == State.green)); //168
    L1' = (if (cond1) then State.yellow else (if (cond2) then State.red else L1)); //187
    L2' = (if (cond2) then State.yellow else (if (cond3) then State.red else L2)); //206
    L3' = (if (cond3) then State.green else L3); //218
    L4' = (if (cond4) then State.yellow else L4); //230

  }
}
