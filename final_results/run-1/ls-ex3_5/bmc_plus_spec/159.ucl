module Thermostat {
  var cooling: boolean;
  var heating: boolean;

  input temp: real;

  output heatOn: boolean;
  output heatOff: boolean;

  init {
    heating = false; //36
    cooling = false; //40

  }
  next {
    if ((temp >= 22.0) && !heating) {
      heating' = true; //56
      cooling' = false; //60
      heatOn' = true; //64
    } else {
      if ((temp <= 18.0) && !cooling) {
        cooling' = true; //79
        heating' = false; //83
        heatOff' = true; //87
      } else {
        heating' = false; //92
        cooling' = false; //96
        heatOn' = false; //100
        heatOff' = false; //104
      }
    }

  }
  invariant temp_inv : ((temp >= 18.0) && (temp <= 22.0));
  invariant heatOn_inv : (((temp >= 22.0) && !cooling) ==> heatOn);
  invariant heatOff_inv : (((temp <= 18.0) && !heating) ==> heatOff);
  invariant heating_inv : (heating ==> ((temp >= 22.0) && !cooling));
  invariant cooling_inv : (cooling ==> ((temp <= 18.0) && !heating));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
