module Thermostat {
  var heatOff: boolean;
  var heatOn: boolean;
  var temp: integer;

  init {
    temp = 20;
    heatOn = true;
    heatOff = false;

  }
  next {
    if (heatOn) {
      if (temp < 22) {
        temp' = (temp + 1);
      } else {
        heatOn' = false;
        heatOff' = true;
      }
    } else {
      if (heatOff) {
        if (temp > 18) {
          temp' = (temp - 1);
        } else {
          heatOn' = true;
          heatOff' = false;
        }
      }
    }

  }
  define invariant1 : boolean = (temp >= 20);
  define invariant2 : boolean = (temp <= 22);
  invariant spec: (invariant1 && invariant2);

  control  {
    bmc(3);
    check;
    print_results;
  }
}
