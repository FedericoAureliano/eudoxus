module Counter {
  var i: integer;

  init {
    i = 0; //42

  }
}
module Display {
  input input_: integer;

}
module CarCounter {
  type Bit = real;

  var i: boolean;
  var arrival: Bit;
  var departure: Bit;
  var counter: integer;

  instance arrival_detector: ArrivalDetector();
  instance departure_detector: DepartureDetector();
  instance counting: Counter();
  instance display: Display(input_:(counter));

}
