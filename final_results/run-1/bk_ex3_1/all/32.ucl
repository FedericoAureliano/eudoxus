module TrafficLights {
  var green1: boolean;
  var green2: boolean;
  var red1: boolean;
  var red2: boolean;

  init {
    green1 = false; //30
    red1 = true; //34
    green2 = true; //38
    red2 = false; //42

  }
  next {
    if ((green1 == false) && (red1 == true)) {
      green1' = true; //60
      red1' = false; //64
    }
    if ((green2 == true) && (red2 == false)) {
      green2' = false; //82
      red2' = true; //86
    }

  }
  invariant green1_inv : (green1 != red1);
  invariant red1_inv : (red1 != green1);
  invariant green2_inv : (green2 != red2);
  invariant red2_inv : (red2 != green2);
  invariant traffic_light1_inv : (red1 == green2);
  invariant traffic_light2_inv : (red2 == green1);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
