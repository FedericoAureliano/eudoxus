module TrafficLights {
  var green1: boolean;
  var green2: boolean;
  var red1: boolean;
  var red2: boolean;

  init {
    if (red1 && red2) {
      green1 = true; //36
      green2 = false; //40
    } else {
      if (red1) {
        green1 = true; //48
      }
    }

  }
  next {
    if (green1) {
      if (red2) {
        green1' = false; //63
        red1' = true; //67
      }
    } else {
      if (green2) {
        if (red1) {
          green2' = false; //80
          red2' = true; //84
        }
      }
    }

  }
  invariant red1_inv : !green1;
  invariant green1_inv : !red1;
  invariant red2_inv : !green2;
  invariant green2_inv : !red2;

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
