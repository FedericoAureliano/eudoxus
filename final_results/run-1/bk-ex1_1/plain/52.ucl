module Module {
  var x: integer;

  next {
    if (x < 200) {
      x' = (x + 1); //28
    } else {
      if (x > 0) {
        x' = (x - 1); //42
      } else {
        if (x == 200) {
          x' = 0; //53
        }
      }
    }

  }
  invariant spec: ((x >= 0) && (x <= 200));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
