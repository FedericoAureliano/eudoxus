module TrafficLight {
  var count: integer;
  var pedestrian: boolean;
  var sigG: boolean;
  var sigR: boolean;
  var sigY: boolean;
  var state: integer;

  init {
    state = 0; //38
    count = 0; //42
    sigG = false; //46
    sigY = false; //50
    sigR = true; //54

  }
  next {
    if (state == 0) {
      if (count < 60) {
        count' = (count + 1); //75
      } else {
        state' = 1; //80
        count' = 0; //84
        sigG' = true; //88
        sigR' = false; //92
      }
    } else {
      if (state == 1) {
        if (pedestrian) {
          if (count >= 60) {
            state' = 2; //113
            count' = 0; //117
            sigG' = false; //121
            sigY' = true; //125
          } else {
            state' = 3; //130
          }
        } else {
          if (count < 60) {
            count' = (count + 1); //145
          }
        }
      } else {
        if (state == 2) {
          if (count < 5) {
            count' = (count + 1); //168
          } else {
            state' = 0; //173
            count' = 0; //177
            sigY' = false; //181
            sigR' = true; //185
          }
        } else {
          if (pedestrian) {
            state' = 2; //194
            count' = 0; //198
            sigR' = false; //202
            sigG' = false; //206
            sigY' = true; //210
          }
        }
      }
    }

  }
}
