module Module {
  var heatOff: boolean;
  var heatOn: boolean;
  var temp: integer;
  var t: integer;
  var prevTemp: integer;
  var runningTime: integer;
  var offTime: integer;

  init {
    heatOn = (temp <= 20); //46
    heatOff = (temp > 20); //54
    runningTime = 0; //58
    offTime = 0; //62

  }
  procedure step()
    modifies offTime;
    modifies runningTime;
  {
    if (heatOn) {
      offTime = 0; //71
      runningTime = (runningTime + 1); //78
      if (runningTime >= 30) {
        runningTime = 0; //88
      }
    }
    if (heatOff) {
      runningTime = 0; //99
      offTime = (offTime + 1); //106
      if (offTime >= 120) {
        offTime = 0; //116
      }
    }
  }

  next {
    call step();
  }
}
