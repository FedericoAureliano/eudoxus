module EventCounter {
  var temp: real;
  var count: integer;

  init {
    temp = 0.0; //22
    count = 0; //26

  }
  next {
    if (temp > 50.0) {
      count' = (count + 1); //41
    }

  }
  invariant temp_inv : (temp >= 0.0);
  invariant count_inv : (count >= 0);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
