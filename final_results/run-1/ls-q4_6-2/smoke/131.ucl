module Automobile {
  var ignitian: boolean;
  var time: integer;
  var warn: boolean;
  var beep: boolean;
  var light: boolean;

  init {
    beep = false; //34
    light = false; //38
    time = 0; //42

  }
  next {
    if ((ignitian && warn) && (time < 30)) {
      beep' = true; //60
      time' = (time + 1); //67
    } else {
      beep' = false; //72
      time' = 0; //76
    }
    if (warn) {
      light' = true; //84
    } else {
      light' = false; //89
    }

  }
  invariant spec: (beep == ((ignitian && warn) && (time < 30)));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
