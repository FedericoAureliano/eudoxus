module Ferryman {
  var cabbage: enum { A, B };
  var carry: enum { A, B };
  var ferryman: enum { A, B };
  var goat: enum { A, B };
  var wolf: enum { A, B };

  invariant spec: (((wolf == A) && ((cabbage == A) && ((ferryman == A) && (goat == A)))) ==> ((carry == B) && ((wolf == B) && ((cabbage == B) && ((ferryman == B) && (goat == B))))));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
