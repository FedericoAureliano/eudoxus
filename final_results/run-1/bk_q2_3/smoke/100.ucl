module TrafficLights {
  var L1: enum { amber, green, red, yellow };
  var L2: enum { amber, green, red, yellow };
  var L3: enum { amber, green, red, yellow };
  var L4: enum { amber, green, red, yellow };
  var controller: integer;
  var timer: integer;

  init {
    controller = 1; //54
    timer = 0; //58

  }
  next {
    if (controller == 1) {
      if (timer == 0) {
        L1' = green; //76
        L3' = green; //80
      } else {
        if (timer == 2) {
          L1' = yellow; //91
          L3' = yellow; //95
        } else {
          if (timer == 3) {
            L1' = red; //106
            L3' = red; //110
          } else {
            if (timer == 4) {
              L1' = amber; //121
              L3' = amber; //125
              controller' = 2; //129
              timer' = 0; //133
            }
          }
        }
      }
    } else {
      if (controller == 2) {
        if (timer == 0) {
          L2' = green; //155
        } else {
          if (timer == 2) {
            L2' = yellow; //166
          } else {
            if (timer == 3) {
              L2' = red; //177
            } else {
              if (timer == 4) {
                L2' = amber; //188
                controller' = 3; //192
                timer' = 0; //196
              }
            }
          }
        }
      } else {
        if (controller == 3) {
          if (timer == 0) {
            L4' = green; //218
          } else {
            if (timer == 2) {
              L4' = yellow; //229
            } else {
              if (timer == 3) {
                L4' = red; //240
              } else {
                if (timer == 4) {
                  L4' = amber; //251
                  controller' = 1; //255
                  timer' = 0; //259
                }
              }
            }
          }
        }
      }
    }
    timer' = (timer + 1); //275

  }
}
