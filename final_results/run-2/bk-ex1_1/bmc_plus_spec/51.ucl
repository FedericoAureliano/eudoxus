module ConcurrentProgram {
  instance inc: Inc();
  instance dec: Dec();
  instance reset: Reset();

}
module Inc {
  var x: integer;
  var y: integer;

  next {
    x' = (x + 1); //48
    y' = (y + 1); //55

  }
}
module Dec {
  var x: integer;

  next {
    x' = (x - 1); //80

  }
}
module Reset {
  var x: integer;

  next {
    if (x == 200) {
      x' = 0; //108
    }

  }
  invariant x_inv : ((x >= 0) && (x <= 200));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
