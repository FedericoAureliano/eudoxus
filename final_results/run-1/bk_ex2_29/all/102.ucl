module BookingSystem {
  var BCR_state: integer;
  var BP_state: integer;
  var Printer_state: bv1;

  next {
    if (BCR_state == 0) {
      if (BCR_state == 0) {
        BCR_state' = 1; //40
      }
    }
    if (BP_state == 0) {
      if (BCR_state == 1) {
        BP_state' = 1; //60
      }
    }
    if (Printer_state == 0bv1) {
      if (BP_state == 1) {
        Printer_state' = 1bv1; //86
      }
    }

  }
  invariant BCR_state_inv : ((BCR_state >= 0) && (BCR_state <= 1));
  invariant BP_state_inv : ((BP_state >= 0) && (BP_state <= 1));
  invariant Printer_state_inv : ((Printer_state >= 0bv1) && (Printer_state <= 1bv1));
  invariant Interaction_order_inv : ((BCR_state == 0) && ((BP_state == 1) && (Printer_state == 0bv1)));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
