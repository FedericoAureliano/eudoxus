module Thermostat {
  input temp: real;

  output heatOn: boolean;
  output heatOff: boolean;

  procedure step()
    modifies heatOff;
    modifies heatOn;
  {
    if (temp > 22.0) {
      heatOn = false; //34
    } else {
      if (temp < 18.0) {
        heatOff = false; //45
      }
    }
    if ((temp >= 20.0) && (temp <= 22.0)) {
      heatOff = true; //64
    } else {
      heatOn = true; //69
    }
  }

  next {
    call step();
  }
}
