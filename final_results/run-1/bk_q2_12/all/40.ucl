module LeaderElection {
  var m: bv32;
  var id: bv32;
  var n: bv32;
  var stop: boolean;

  next {
    if (m == id) {
      stop' = true; //41
    } else {
      if (m > id) {
        m' = m; //54
      }
    }

  }
  invariant m_inv : ((m >= 1bv32) && (m <= n));
  invariant id_inv : ((id >= 1bv32) && (id <= n));
  invariant n_inv : (n >= 1bv32);
  invariant stop_inv : (stop == (id == n));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
