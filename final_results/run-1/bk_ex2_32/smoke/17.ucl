module Sender {
  var c: boolean;

  input d: boolean;
  input m: bv8;
  input b: boolean;

  output c_ack: boolean;

  next {
    if (c && d) {
      c_ack' = b; //45
    }
    if (c_ack) {
      c' = !c; //56
    }

  }
}
module Receiver {
  var d: boolean;

  input c: boolean;
  input m: bv8;
  input b: boolean;

  output d_ack: boolean;

  next {
    if (c && d) {
      d_ack' = b; //106
    }
    if (d_ack) {
      d' = !d; //117
    }

  }
}
