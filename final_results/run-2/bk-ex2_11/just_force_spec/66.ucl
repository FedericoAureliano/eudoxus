module Module {
  var x: boolean;
  var y: boolean;
  var r: boolean;
  var r_inf: boolean;
  var r_inf_inv: boolean;
  var x_inv: boolean;
  var r_inv: boolean;
  var property: boolean;

  init {
    r = false; //46

  }
  next {
    y' = !(x ^ r); //58

  }
  invariant r_inf_inv : !(x || r);
  invariant property : property;

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
