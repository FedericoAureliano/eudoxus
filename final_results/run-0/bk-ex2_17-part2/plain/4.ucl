module TrafficLight {
  var green1: boolean;
  var green2: boolean;
  var red1: boolean;
  var red2: boolean;

  init {
    red1 = true; //30
    green1 = false; //34
    red2 = true; //38
    green2 = false; //42

  }
  next {
    red1' = ((red1 && !green1) || (green1 && !red1)); //60
    green1' = !red1; //66
    red2' = ((red2 && !green2) || (green2 && !red2)); //82
    green2' = !red2; //88

  }
  invariant spec: ((red1 != green1) && (red2 != green2));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
