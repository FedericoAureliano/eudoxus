module Module {
  type Process = integer;

  var x: integer;
  var P1: Process;
  var P2: Process;
  var P3: Process;

  init {
    x = 0; //35

  }
  next {
    if (x < 10) {
      x' = (x + 1); //50
      P1' = x; //55
      P2' = x; //60
      P3' = x; //65
    }

  }
  invariant spec: (x == 2);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
