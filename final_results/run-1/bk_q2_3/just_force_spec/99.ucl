module TrafficLights {
  var L1: ??;
  var L2: ??;
  var L3: ??;
  var L4: ??;

  init {
    L1 = 00; //46
    L2 = 00; //50
    L3 = 00; //54
    L4 = 00; //58

  }
  next {
    if ((((L1 == 00) && (L2 == 00)) && (L3 == 00)) && (L4 == 00)) {
      L1' = 01; //88
      L3' = 01; //92
    } else {
      if ((L1 == 01) && (L3 == 01)) {
        L1' = 10; //109
        L3' = 10; //113
        L2' = 10; //117
      } else {
        if (L2 == 10) {
          L2' = 11; //128
        } else {
          if (L2 == 11) {
            L2' = 00; //139
            L4' = 10; //143
          } else {
            if (L4 == 10) {
              L4' = 11; //154
            } else {
              if (L4 == 11) {
                L4' = 00; //165
                L1' = 01; //169
                L3' = 01; //173
              }
            }
          }
        }
      }
    }

  }
  invariant L1_inv : ((((L1 == 00) || (L1 == 01)) || (L1 == 10)) || (L1 == 11));
  invariant L2_inv : ((((L2 == 00) || (L2 == 01)) || (L2 == 10)) || (L2 == 11));
  invariant L3_inv : ((((L3 == 00) || (L3 == 01)) || (L3 == 10)) || (L3 == 11));
  invariant L4_inv : ((((L4 == 00) || (L4 == 01)) || (L4 == 10)) || (L4 == 11));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
