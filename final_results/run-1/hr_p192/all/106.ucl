module Module {
  var aux_old: integer;
  var request: boolean;
  var status_old: integer;
  var aux: boolean;
  var status: integer;

  init {
    status = 0; //34

  }
  next {
    aux' = request; //41
    if (aux) {
      status' = 1; //48
    }

  }
  invariant request_inv : (request == true);
  invariant status_inv : (status == (if !aux then status_old else 1));
  invariant aux_inv : (((aux == false) || ((aux == true) && (status == 1))) || ((aux == true) && (aux_old == 1)));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
