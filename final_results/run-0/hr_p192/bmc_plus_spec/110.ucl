module Module {
  var bool: boolean;
  var request: boolean;
  var status: bv1;

  init {
    request = bool; //28
    status = 0bv1; //35

  }
  next {
    status' = (if (request) then 1bv1 else status); //49

  }
  invariant status_inv : (!request && (status == 0bv1));
  invariant status_inv : (request && (status == 1bv1));
  invariant request_inv : request;
  invariant inv : (request && (status == 1bv1));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
