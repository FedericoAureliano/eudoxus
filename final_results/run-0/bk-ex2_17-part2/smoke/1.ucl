module TrafficLights {
  var red1: bv1;
  var green1: bv1;
  var red2: bv1;
  var green2: bv1;

  init {
    red1 = 1bv1; //37
    green1 = 0bv1; //44
    red2 = 1bv1; //51
    green2 = 0bv1; //58

  }
  next {
    if (red1 != green1) {
      red1' = green1; //72
    }
    if (red2 != green2) {
      red2' = green2; //86
    }

  }
  invariant spec: ((red1 != green1) && (red2 != green2));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
