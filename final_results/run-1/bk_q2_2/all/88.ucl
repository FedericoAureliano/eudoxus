module P2 {
  var INC: integer;
  var LOAD: integer;
  var STORE: integer;

  init {
    LOAD = 0; //26
    INC = 0; //30
    STORE = 0; //34

  }
}
module P1 {
  var INC: integer;
  var LOAD: integer;
  var STORE: integer;

  init {
    LOAD = 0; //64
    INC = 0; //68
    STORE = 0; //72

  }
}
module P3 {
  var INC: integer;
  var LOAD: integer;
  var STORE: integer;

  init {
    LOAD = 0; //102
    INC = 0; //106
    STORE = 0; //110

  }
}
module Process {
  var x: integer;

  init {
    x = 0; //132

  }
  next {
    if (x < 10) {
      x' = (x + 1); //147
    }

  }
}
module Parallel {
  instance p1: P1();
  instance p2: P2();
  instance p3: P3();

  invariant x_inv : ((p3.x <= 30) && ((p3.x >= 0) && ((p2.x <= 30) && ((p2.x >= 0) && ((p1.x >= 0) && (p1.x <= 30))))));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
