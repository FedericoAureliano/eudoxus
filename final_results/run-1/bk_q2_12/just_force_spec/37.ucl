module LeaderElection {
  var i: bv2;
  var n: bv2;
  var id: bv2;
  var m: bv2;
  var msg: bv2;
  var send: [bv2]bv2;

  init {
    m = id; //50

  }
  next {
    msg' = send[id]; //60
    if (msg == id) {
    }
    if (msg > id) {
      send' = send[msg -> m]; //85
    }

  }
  invariant id_inv : ((id >= 1bv2) && (id <= n));
  invariant m_inv : ((m >= 1bv2) && (m <= n));
  invariant msg_inv : ((msg >= 1bv2) && (msg <= n));
  invariant send_inv : (!(send[i] == 0bv2) ==> ((send[i] >= 1bv2) && (send[i] <= n)));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
