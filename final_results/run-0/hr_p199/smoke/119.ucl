module FerryPuzzle {
  type location = bv1;

  var ferryman: location;
  var goat: location;
  var cabbage: location;
  var wolf: location;
  var carry: location;

  procedure step()
    modifies ferryman;
    modifies carry;
  {
    ferryman = carry; //42
    if (ferryman == 0bv1) {
      carry = 1bv1; //58
      ferryman = 1bv1; //65
    }
  }

  next {
    call step();
  }
}
