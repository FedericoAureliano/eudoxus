module Stack {
  var n: integer;
  var s: integer;

  init {
    n = 26; //22
    s = 0; //26

  }
  next {
    if (s > 0) {
      s' = (s - 1); //41
    } else {
      s' = s; //47
    }

  }
  invariant n_inv : (n >= 0);
  invariant s_inv : ((s >= 0) && (s <= n));

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
