module TrafficLight {
  var count: integer;
  var pedestrian: boolean;
  var sigG: boolean;
  var sigY: boolean;
  var sigR: boolean;

  init {
    sigR = true; //34

  }
  procedure step()
    modifies sigY;
    modifies sigR;
    modifies sigG;
    modifies count;
  {
    if (count < 60) {
      count = (count + 1); //49
      if (sigR) {
        sigR = true; //56
        sigG = false; //60
        sigY = false; //64
      }
    } else {
      if (sigR) {
        if (pedestrian) {
          sigR = false; //77
          sigG = false; //81
          sigY = false; //85
        } else {
          sigR = false; //90
          sigG = true; //94
          sigY = false; //98
        }
      } else {
        if (sigG) {
          if (count < 120) {
            count = (count + 1); //116
            if (pedestrian) {
              count = 60; //123
            }
          } else {
            if (pedestrian) {
              sigG = false; //133
              sigY = true; //137
            } else {
              sigG = false; //142
              sigY = false; //146
              sigR = true; //150
            }
          }
        }
      }
    }
  }

  next {
    call step();
  }
}
