module RailroadCrossing {
  var train_state: record { ??: boolean, ??: boolean, ??: boolean, ??: boolean, up: record {  } };
  var controller_state: integer;
  var gate_state: record { in_: boolean, far: boolean, down: boolean, near: boolean, up: record {  } };

  init {
    train_state = train_state.far; //59
    controller_state = 0; //63
    gate_state = gate_state.up; //70

  }
  next {
    if ((controller_state == 0) && (train_state == train_state.near)) {
      controller_state' = 1; //91
    } else {
      if ((controller_state == 1) && (gate_state == gate_state.up)) {
        controller_state' = 2; //111
        gate_state' = gate_state.down; //118
      } else {
        if ((controller_state == 2) && (train_state == train_state.in_)) {
          controller_state' = 3; //138
          gate_state' = gate_state.up; //145
        } else {
          if ((controller_state == 3) && (gate_state == gate_state.up)) {
            controller_state' = 0; //165
            gate_state' = gate_state.up; //172
          }
        }
      }
    }

  }
}
