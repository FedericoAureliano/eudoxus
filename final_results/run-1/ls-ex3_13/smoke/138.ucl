module TrafficLightStateMachine {
  var count: integer;
  var pedestrian: boolean;
  var sigG: bv4;
  var sigR: bv6;
  var sigY: bv7;
  var state: integer;

  init {
    state = 0; //41
    count = 0; //45

  }
  procedure step()
    modifies count;
    modifies else_;
  {
    count = (count + 1); //54
    if (state == 0) {
      count = 0; //64
    }
    if (state == 1) {
      count = 0; //76
      else_ = 3; //80
      count = 0; //84
    }
    if (state == 2) {
      count = 0; //96
    }
    if (state == 3) {
      count = 0; //108
    }
  }

  next {
    call step();
  }
}
