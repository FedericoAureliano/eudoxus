module BeverageVendingMachine {
  var coin_input: integer;
  var coin_output: integer;
  var dispensed_drinks_input: integer;
  var dispensed_drinks_output: integer;
  var coin: integer;
  var dispensed_drinks: integer;

  init {
    coin = 0; //38
    dispensed_drinks = 0; //42

  }
  next {
    coin_input' = coin; //49
    dispensed_drinks_input' = dispensed_drinks; //54
    coin_output' = (coin_input + 1); //61
    dispensed_drinks_output' = (dispensed_drinks_input + 1); //68
    coin' = coin_output; //73
    dispensed_drinks' = dispensed_drinks_output; //78

  }
  invariant spec: (coin >= dispensed_drinks);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
