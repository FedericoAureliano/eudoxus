module TrafficLights {
  var green1: boolean;
  var green2: boolean;
  var red1: boolean;
  var red2: boolean;

  init {
    red1 = true; //30
    green1 = false; //34
    red2 = true; //38
    green2 = false; //42

  }
  next {
    if ((red1 && green1) || (red1 && red2)) {
      red1' = !red1; //62
      green1' = !green1; //68
    } else {
      if ((red2 && green2) || (green1 && red2)) {
        red2' = !red2; //87
        green2' = !green2; //93
      }
    }

  }
  invariant spec: ((red1 && green1) || (red2 && green2));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
