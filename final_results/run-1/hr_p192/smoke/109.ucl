module Module {
  var request: boolean;
  var status: integer;
  var auxiliary: boolean;

  next {
    if (request) {
      auxiliary' = true; //30
      status' = 1; //34
    } else {
      auxiliary' = auxiliary; //40
    }

  }
  invariant spec: (request ==> (status == 1));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
