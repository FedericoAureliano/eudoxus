module Module {
  var b1: boolean;
  var b2: boolean;
  var crit1: boolean;
  var crit2: boolean;
  var wait1: boolean;
  var wait2: boolean;
  var x: integer;

  init {
    b1 = false; //42
    b2 = false; //46
    x = 1; //50

  }
  next {
    crit1' = (b1 && (x == 2)); //63
    crit2' = (b2 && (x == 1)); //74
    wait1' = (!((x == 1) || !b2) && b1); //90
    wait2' = (!((x == 2) || !b1) && b2); //106
    x' = (if (crit1) then 2 else (if (crit2) then 1 else x)); //119
    b1' = (if (wait1) then false else b1); //128
    b2' = (if (wait2) then false else b2); //137

  }
}
