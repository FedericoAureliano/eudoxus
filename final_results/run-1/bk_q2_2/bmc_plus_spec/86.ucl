module ParallelProgram {
  var x: integer;
  var tmp: integer;

  init {
    x = 0; //22

  }
  next {
    if (x < 30) {
      tmp' = x; //35
      x' = (x + 1); //42
    } else {
      x' = tmp; //48
    }

  }
  invariant x_inv : (x == 2);
  invariant tmp_inv : (tmp == 0);

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
