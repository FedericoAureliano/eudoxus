module Module {
  var s: [integer]n;
  var index: integer;
  var top_value: integer;

  init {
    index = 0; //30
    top_value =  -1; //35

  }
  procedure step()
    modifies index;
    modifies top_value;
  {
    index = (index + 1); //44
    if (index < n) {
      if (index > 0) {
        top_value = s[(index - 1)]; //67
      } else {
        index = (index - 1); //75
      }
    }
  }

  next {
    call step();
  }
  invariant spec: ((index >= 0) && (index < n));
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
