module BookingSystem {
  var BCR_scanned: boolean;
  var article_printed: boolean;
  var data_received: boolean;
  var data_transmitted: boolean;
  var print_code_sent: boolean;
  var print_command_sent: boolean;
  var BCR_state: bv1;
  var BP_state: bv1;
  var Printer_state: bv1;

  next {
    if (BCR_state == 0bv1) {
      if (BCR_scanned) {
        BCR_state' = 1bv1; //69
      }
    } else {
      if (BCR_state == 1bv1) {
        if (data_transmitted) {
          BCR_state' = 0bv1; //91
        }
      }
    }
    if (BP_state == 0bv1) {
      if (data_received) {
        BP_state' = 1bv1; //115
      }
    } else {
      if (BP_state == 1bv1) {
        if (print_command_sent) {
          BP_state' = 0bv1; //137
        }
      }
    }
    if (Printer_state == 0bv1) {
      if (print_code_sent) {
        Printer_state' = 1bv1; //161
      }
    } else {
      if (Printer_state == 1bv1) {
        if (article_printed) {
          Printer_state' = 0bv1; //183
        }
      }
    }

  }
}
