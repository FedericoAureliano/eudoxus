module Module {
  var r: boolean;
  var r_next: boolean;
  var x: boolean;
  var y: boolean;
  var i: integer;

  init {
    r = false; //34
    i = 0; //38

  }
  next {
    i' = (if (i == 0) then 1 else 0); //51
    r_next' = (x || r); //59
    r' = (if (r == false) then r_next else r_next); //72
    y' = !(x != r); //82

  }
  invariant spec: y;
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
