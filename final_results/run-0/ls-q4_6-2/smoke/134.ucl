module Automobile {
  var warn: boolean;
  var nowarn: boolean;
  var time: integer;
  var ignition: boolean;
  var buckled: boolean;

  init {
    warn = false; //34
    nowarn = false; //38
    time = 0; //42
    ignition = false; //46
    buckled = false; //50

  }
  next {
    if (ignition && !buckled) {
      time' = (time + 1); //66
      if (time >= 30) {
        warn' = false; //76
        nowarn' = true; //80
      }
    } else {
      time' = 0; //87
      warn' = false; //91
      nowarn' = false; //95
    }

  }
  invariant spec: (((warn == ignition) && !buckled) || nowarn);
  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
