module TrafficLight {
  var green: boolean;
  var red: boolean;

  init {
    red = true;
    green = false;

  }
  next {
    if (red) {
      red' = false;
      green' = true;
    } else {
      red' = true;
      green' = false;
    }

  }
  define red_inv() : boolean = !green;
  define green_inv() : boolean = !red;
  invariant spec: (red_inv() && green_inv());

  control  {
    v = bmc(3);
    check;
    print_results;
    v.print_cex();
  }
}
